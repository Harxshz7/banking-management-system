# Java bytecode
*.class

# Packages (allow lib/jbcrypt-0.4.jar)
*.jar
*.war
*.ear
!lib/jbcrypt-0.4.jar

# Compiled output
/out/
/target/
/build/
/dist/
/lib/*
!lib/jbcrypt-0.4.jar

# IDEs
.vscode/
.idea/
*.iml
*.ipr
*.iws
/.project
/.classpath
/.settings/

# Maven/Gradle
/.mvn/
/.gradle/

# OS files
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp
*.temp
*.swp

# Application data and databases
/banking_data/
*.db
*.dat

# Other
*.class

# Keep local env files out
.env
